Screen {
    layout: horizontal;
}

#sidebar {
    width: 20%;
    height: 100%;
    background: $surface;
    border-right: heavy $accent;
    padding: 1;
}

#sidebar-title {
    border-bottom: heavy $primary;
    text-align: center;
    text-style: bold;
    padding: 1;
}

#content {
    width: 80%;
    height: 100%;
    padding: 1;
}

#store-layout, #detail-layout {
    width: 100%;
    height: 100%;
    padding: 1;
}

#store-tabs {
    height: 1fr;
    width: 100%;
    padding: 0 1;
}

TabbedContent > ContentTabs {
    dock: top;
    height: 3;
    background: $panel;
    border-bottom: solid $accent;
}

TabbedContent Tab {
    height: 1;
    padding: 0 2;
    text-align: center;
    color: $foreground 60%;
}

TabbedContent Tab.-active {
    color: $text;
    background: $accent;
}

TabbedContent > ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 100%;
    border: solid $accent;
    padding: 1;
}

#tools-table {
    height: auto;
    margin: 0;
}

#search-table, #installed-table {
    height: 1fr;
    margin: 0 0 0 0;
}

#tools-action-bar, #search-action-bar, #installed-action-bar {
    height: 3;
    align: center middle;
    border: solid $accent;
    padding: 0 1;
    margin: 0;
}

#tools-action-bar Button, #search-action-bar Button, #installed-action-bar Button {
    margin: 0 1;
}

#search-top, #installed-top {
    height: 3;
    align: center middle;
    margin: 0;
}

#search-top Input, #installed-top Input {
    width: 1fr;
    margin: 0;
}

#search-managers, #installed-managers {
    height: 3;
    align: left middle;
    margin: 0;
}

#search-managers Checkbox, #installed-managers Checkbox {
    margin: 0 1 0 0;
}

#search-managers #all, #installed-managers #all {
    text-style: bold;
    margin-right: 3;
}

#tools-result, #search-result, #installed-result {
    height: 1;
    background: $panel;
    border-top: dashed $primary;
    text-align: center;
    padding: 0 2;
    width: 100%;
}

DataTable {
    height: 1fr;
    margin: 0;
}

.monitor-card {
    border: solid $primary;
    padding: 1;
    margin: 1;
    height: auto;
}

.detail-card {
    border: solid $accent;
    padding: 2;
    margin: 1;
}

#actions {
    align: center middle;
    height: 5;
}

#actions Button {
    margin: 0 1;
}

#action-result {
    height: 3;
    background: $panel;
    border-top: heavy $primary;
    text-align: center;
    padding: 0 2;
    width: 100%;
}

#left-panel, #right-panel {
    width: 50%;
    height: 100%;
}

Button {
    margin: 0 1;
}

#package-info {
    padding: 1;
}

#system-card {
    border: solid $primary;
    padding: 1;
    margin: 1;
}

#package-table {
    border: solid $accent;
    padding: 1;
    margin: 1;
    height: 1fr;
}

#full-system-content {
    width: 100%;
    height: 100%;
    padding: 1;
    overflow-y: auto;
}

.fs-section {
    border: solid $surface;
    padding: 1;
    margin: 0 0 1 0;
    height: auto;
}

#action-bar {
    height: 3;
    align: center middle;
    border: solid $accent;
    padding: 0 1;
    margin: 1 0;
}

#action-bar Button {
    margin: 0 1;
}

.sel-label {
    padding: 0 2;
    text-style: bold;
}

#action-result-store {
    height: 3;
    background: $panel;
    border-top: heavy $primary;
    text-align: center;
    padding: 0 2;
    width: 100%;
}

#inner-table {
    height: 100%;
}
